{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dangle",
  "version": "0.1.4",
  "identifier": "app.dangle.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.entertainment",
    "shortDescription": "A tiny thing for your desktop.",
    "longDescription": "Dangle hangs a small physical charm from the top of your screen. Grab it, swing it, let go.",
    "copyright": "\u00a9 2026 Dangle",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 452
        },
        "appPosition": {
          "x": 180,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 215
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QUYwQTE4QTM4QUJFQkYKUldTL3ZvcWpHQXF2V0N3a0syYWNnSG54cHpwQ0kzWkF6enVDRXd4cHh3U2dCemZUeTNvQ3pxK0cK",
      "endpoints": [
        "https://github.com/G-Deepak-05/Dangle/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
